# Skopiuj do pliku .env i uzupelnij. Plik .env nie trafia do repozytorium.

# Dostawca modelu: gemini albo anthropic (domyslnie gemini)
LLM_PROVIDER=gemini

# Gemini: klucz z https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcjonalnie inny model, domyslnie gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic: klucz z https://platform.claude.com, tu albo w zmiennych srodowiskowych systemu
# ANTHROPIC_API_KEY=
# Opcjonalnie inny model, domyslnie claude-haiku-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcjonalnie inna baza, domyslnie sqlite:///database.db
# DATABASE_URL=sqlite:///database.db
